<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.apache.fory.benchmark</groupId>
    <artifactId>graalvm-native-json-benchmark</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>fory-app</artifactId>

  <dependencies>
    <dependency>
      <groupId>org.apache.fory.benchmark</groupId>
      <artifactId>benchmark-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.fory</groupId>
      <artifactId>fory-json</artifactId>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <extensions>true</extensions>
            <executions>
              <execution>
                <id>build-native</id>
                <phase>package</phase>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <imageName>fory-json-benchmark</imageName>
              <mainClass>org.apache.fory.benchmark.fory.ForyBenchmarkMain</mainClass>
              <buildArgs>
                <buildArg>--no-fallback</buildArg>
                <buildArg>-O3</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
